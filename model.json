{
  "kind": "industrial_read",
  "version": "0.1.0",
  "title": "Industrial Read",
  "description": "Read allowlisted Modbus TCP or OPC UA points with calibration, quality and explicit stale-value invalidation; no equipment writes.",
  "repository_url": "https://github.com/HackInvent/bloxmith-industrial-read",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "Linux, Python 3.10+, authorized equipment endpoint. Modbus TCP is plaintext; OPC UA requires asyncua 2.0.1 and configured certificates for encrypted access."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "command",
        "title": "Command",
        "accepts": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "measurements",
        "title": "Measurements",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "status",
        "title": "Connection / quality",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "enabled": false,
    "protocol": "modbus_tcp",
    "endpoint": "",
    "allow_insecure": false,
    "unit_id": 1,
    "points": [],
    "start_mode": "on_command",
    "interval_ms": 1000,
    "connect_timeout_ms": 10000,
    "read_timeout_ms": 5000,
    "stale_after_ms": 15000,
    "reconnect_attempts": 2,
    "reconnect_delay_ms": 1000,
    "max_measurements_per_run": 100000,
    "opcua_security": "sign_encrypt",
    "credential_ref": "",
    "server_certificate_pem": "",
    "application_uri": "urn:hackinvent:bloxsmith:industrial-read",
    "source_max_age_ms": 30000,
    "max_clock_skew_ms": 1000,
    "require_source_timestamp": true
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
